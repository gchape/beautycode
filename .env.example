# Production domain. Compose derives SITE_URL and VITE_SITE_URL from this value.
DOMAIN=beautycode.com.ge

# Migrations directory path relative to the project root.
MIGRATIONS_DIR=./migrations

# Must match aws_region in infra/terraform/terraform.tfvars.
AWS_REGION=eu-central-1
# Set this to the Terraform `backups_bucket` output after provisioning.
S3_BACKUPS_BUCKET=REPLACE_WITH_TERRAFORM_BACKUPS_BUCKET

# AWS credentials come from the EC2 instance role.
# Compose supplies NODE_ENV, HOST, PORT, DB_PATH and UPLOADS_DIR.
# Product images are stored in data/uploads on the host and served by nginx at /uploads/.
# Production admin credentials live in secrets/htpasswd.

# For bundled deployments outside Docker, set an absolute migrations directory.
# MIGRATIONS_DIR=/absolute/path/to/migrations

# Public Crisp website ID (not an API secret); included in the browser build.
VITE_CRISP_WEBSITE_ID=58954312-2322-4477-a9b3-21af29c98ff1
