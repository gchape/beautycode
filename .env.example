# Production domain and origin (no trailing slash).
DOMAIN=beautycode.ge
SITE_URL=https://beautycode.ge
# Used for builds outside Docker; Compose builds derive this from SITE_URL.
VITE_SITE_URL=https://beautycode.ge

# Must match the region used to deploy cloudformation.yml.
AWS_REGION=eu-central-1
# Names configured in cloudformation.yml.
S3_IMAGES_BUCKET=beautycode-ge-images
S3_BACKUPS_BUCKET=beautycode-ge-backups

# After deployment, copy the CloudFormation ImagesBaseUrl output here.
# Example: https://d123example.cloudfront.net (no trailing slash).
# Use the CloudFront image URL, not beautycode.ge or an S3 URL.
# Retrieve it with:
# aws cloudformation describe-stacks --stack-name beautycode-storage --region eu-central-1 --query 'Stacks[0].Outputs[?OutputKey==`ImagesBaseUrl`].OutputValue' --output text
IMAGES_BASE_URL=

# AWS credentials come from the EC2 instance role.
# Compose supplies NODE_ENV, HOST, PORT and DB_PATH.
# Production admin credentials live in secrets/htpasswd.
