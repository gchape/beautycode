{
	"name": "beautycode",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview",
		"format": "biome format --write .",
		"lint": "biome check .",
		"check": "pnpm typecheck && pnpm lint && pnpm test",
		"test": "node --test tests/*.test.mjs",
		"backup": "node scripts/backup.ts",
		"restore": "node scripts/restore.ts",
		"backup:dev": "NODE_ENV=development node scripts/backup.ts",
		"restore:dev": "NODE_ENV=development node scripts/restore.ts",
		"clean:dev": "node scripts/clean-dev.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1165.0",
		"@cloudinary/url-gen": "^1.22.0",
		"@fontsource-variable/noto-sans-georgian": "^5.3.0",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-query": "5.107.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.5",
		"class-variance-authority": "^0.7.1",
		"cloudinary": "^2.11.0",
		"clsx": "^2.1.1",
		"crisp-sdk-web": "^1.2.1",
		"lucide-react": "^1.70.0",
		"nitro": "3.0.261103-rc",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@tanstack/devtools-vite": "0.8.6",
		"@tanstack/router-cli": "^1.168.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.7"
	},
	"engines": {
		"node": ">=26.13 <27"
	}
}
